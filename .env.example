# Copie para .env e ajuste. O servidor lê este arquivo automaticamente.

# E-mails com acesso ao painel (donos). Separe vários por vírgula.
# A conta precisa entrar pelo site com esse e-mail CONFIRMADO (ou pelo Google).
ADMIN_EMAILS=seu-email@gmail.com

# Chave mestra que criptografa tokens e segredos no banco. Gere uma longa e aleatória:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Produção
# NODE_ENV=production
# PORT=3000
# TRUST_PROXY=1        # atrás de Nginx/Caddy/Cloudflare (lê o IP real e detecta HTTPS)
# FORCE_HTTPS=1        # redireciona http → https

# Firebase (já vem configurado com o projeto dashboard-6fa1e; só mude se trocar de projeto)
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=

# Ajustes finos
# PIX_EXPIRE_MIN=30        # validade do Pix gerado
# MAX_ORDER_CENTS=200000   # valor máximo por pedido no site (R$ 2.000)
# RISK_REVIEW_AT=60        # pontuação de risco a partir da qual o pedido é retido
# ADMIN_IDLE_MIN=30        # sessão do painel expira após X min sem uso
